# Keystore configuration for release builds
# Copy this file to 'keystore.properties' and update with your actual values
# DO NOT commit keystore.properties to version control

storeFile=path/to/your/keystore.jks
storePassword=your_store_password
keyAlias=your_key_alias
keyPassword=your_key_password

# Optional AdMob Rewarded Ad Unit ID for production release (defaults to production publisher ID)
admob.rewarded.id=ca-app-pub-3612191981543807/5224354917

<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- EXC-05b: see backup_rules.xml. Both Android 12+ paths must exclude the pairing store. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="pairing_store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pairing_store.xml" />
    </device-transfer>
</data-extraction-rules>
